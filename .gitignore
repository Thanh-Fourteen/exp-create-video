# data — never commit; keep manifests, not bytes

# model artefacts
*.pt
*.pth
*.onnx
*.safetensors
checkpoints/
weights/

# python
.pip-cache/          # cache pip cục bộ, 2,8GB — đừng để lọt vào git
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
dist/
build/

# local
.env
.DS_Store
.claude/settings.local.json

# --- exp-create-video ---
exp/*
!exp/.gitkeep
out/*
!out/.gitkeep
data/music/*
!data/music/.gitkeep

# remotion / node
node_modules/
remotion/out/
.remotion/

# media
*.mp4
*.mov
*.wav
*.mp3
*.png
*.jpg
*.jpeg

# trạng thái runtime của tool autoclick — không phải mã nguồn
.autoclick/
